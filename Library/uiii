        ------------------------------------------------------------------
        -- categories (pill bar inside a tab, e.g. Aimbot | ESP)
        ------------------------------------------------------------------
        local TextService = game:GetService("TextService")

        local function newCategory(name, icon)
            local cat = { Name = name, CardCount = 0, Tab = Tab }
            cat.Page, cat.Cols = newPage()
            local text = (icon and (icon .. "  ") or "") .. name
            local width = TextService:GetTextSize(text, 11, Enum.Font.GothamMedium, Vector2.new(1000, 24)).X + 28
            local pill = New("Frame", {
                Size = UDim2.fromOffset(width, 24), BackgroundColor3 = Theme.Element, BorderSizePixel = 0,
                LayoutOrder = #Tab.Categories + 1, Parent = catBar,
            }, { Corner(12), Stroke(Theme.Stroke, 1, 0.5) })
            local fill = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1, Parent = pill }, { Corner(12) })
            Shiny(fill)
            local lbl = Label(pill, text, 11, Theme.SubText, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)
            lbl.Size, lbl.ZIndex = UDim2.fromScale(1, 1), 2
            local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 3, Parent = pill })
            cat.Button, cat._fill, cat._lbl = pill, fill, lbl

            function cat:Select()
                for _, c in ipairs(Tab.Categories) do
                    c.Page.Visible = false
                    Tween(c._fill, { BackgroundTransparency = 1 })
                    Tween(c._lbl, { TextColor3 = Theme.SubText })
                end
                cat.Page.Visible = true
                Tween(fill, { BackgroundTransparency = 0 })
                Tween(lbl, { TextColor3 = Color3.new(1, 1, 1) })
                Tab.CurrentCategory = cat
            end
            function cat:AddCard(co) return addCard(cat, co) end
            Connect(hit.MouseButton1Click, function() cat:Select() end)
            Connect(pill.MouseEnter, function()
                if Tab.CurrentCategory ~= cat then Tween(lbl, { TextColor3 = Theme.Text }) end
            end)
            Connect(pill.MouseLeave, function()
                if Tab.CurrentCategory ~= cat then Tween(lbl, { TextColor3 = Theme.SubText }) end
            end)
            return cat
        end

        function Tab:AddCategory(o)
            o = type(o) == "string" and { Name = o } or (o or {})
            local cat = newCategory(o.Name or "Category", o.Icon)
            table.insert(Tab.Categories, cat)
            catBar.Visible = true
            catHolder.Position = UDim2.fromOffset(0, 36)
            catHolder.Size = UDim2.new(1, 0, 1, -36)
            if Tab._default then Tab._default.Page.Visible = false end
            if #Tab.Categories == 1 then cat:Select() end
            Tab._lastCategory = cat
            return cat
        end

        -- Tab:AddCard puts the card in the last category (or a plain page if the tab has no categories)
        function Tab:AddCard(co)
            local target = Tab._lastCategory
            if not target then
                if not Tab._default then
                    Tab._default = { CardCount = 0 }
                    Tab._default.Page, Tab._default.Cols = newPage()
                    Tab._default.Page.Visible = true
                end
                target = Tab._default
            end
            return addCard(target, co)
        end

        table.insert(Window.Tabs, Tab)
        if #Window.Tabs == 1 then Tab:Select() end
        return Tab
    end

