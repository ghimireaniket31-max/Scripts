        return num, bar
    end
    local mTime, tBar = metric(14, "SESSION")
    local mFps, fBar = metric(87, "FPS")
    local mPing, pBar = metric(160, "PING")
    Shiny(tBar)

    local chips = New("Frame", {
        Size = UDim2.new(1, -28, 0, 24), Position = UDim2.fromOffset(14, 128), BackgroundTransparency = 1, Parent = Expanded,
    }, { New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }) })
    local function chip(order)
        local f = New("Frame", {
            Size = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Theme.Element, LayoutOrder = order, Parent = chips,
        }, { Corner(12), Pad(10, 0, 10, 0) })
        local l = Label(f, "", 11, Theme.Text, Enum.Font.GothamBold)
        l.Size, l.AutomaticSize, l.RichText, l.TextTruncate = UDim2.new(0, 0, 1, 0), Enum.AutomaticSize.X, true, Enum.TextTruncate.None
        return l
    end
    local chipPlayers, chipRunning = chip(1), chip(2)

    local openFill = New("Frame", { Size = UDim2.new(1, -28, 0, 28), Position = UDim2.fromOffset(14, 160), Parent = Expanded }, { Corner(8) })
    Shiny(openFill)
    local openLbl = Label(openFill, "OPEN HUB", 13, Color3.new(1, 1, 1), Enum.Font.GothamBold, Enum.TextXAlignment.Center)
    openLbl.Size, openLbl.ZIndex = UDim2.fromScale(1, 1), 2
    local openBtn = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 3, Parent = openFill })

    -- live info -----------------------------------------------------------------
    local frames, acc = 0, 0
    Connect(RunService.RenderStepped, function(dt) frames += 1; acc += dt end)
    task.spawn(function()
        while gui.Parent do
            task.wait(0.25)
            local fps = acc > 0 and math.floor(frames / acc + 0.5) or 0
            frames, acc = 0, 0
            local ping = 0
            pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5) end)
            local t = os.time() - sessionStart
            if Island.Visible then
                timeLbl.Text = fmtTime(t)
                fpsLbl.Text, fpsLbl.TextColor3 = fps .. " FPS", fpsColor(fps)
                pingLbl.Text, pingLbl.TextColor3 = ping .. "ms", pingColor(ping)
                if expanded then
                    mTime.Text = fmtTime(t)
                    mFps.Text, mFps.TextColor3 = tostring(fps), fpsColor(fps)
                    mPing.Text, mPing.TextColor3 = tostring(ping), pingColor(ping)
                    Tween(tBar, { Size = UDim2.fromScale((t % 60) / 60, 1) }, 0.25)
                    fBar.BackgroundColor3 = fpsColor(fps)
                    Tween(fBar, { Size = UDim2.fromScale(math.clamp(fps / 60, 0, 1), 1) }, 0.25)
                    pBar.BackgroundColor3 = pingColor(ping)
                    Tween(pBar, { Size = UDim2.fromScale(1 - math.clamp(ping / 300, 0, 1), 1) }, 0.25)
                    chipPlayers.Text = string.format('<font color="#968085">Players</font>  %d/%d', #Players:GetPlayers(), Players.MaxPlayers)
                    chipRunning.Text = string.format('<font color="#968085">Running</font>  %d', Window._running or 0)
                    hubLbl.Text = string.upper(TitleLbl.Text) .. (Window.Current and ("  ·  " .. string.upper(Window.Current.Name)) or "")
                end
            end
        end
    end)

    -- animations --------------------------------------------------------------------
    local function setExpanded(v)
        if v == expanded then return end
        expanded = v
        if v then
            local vp = gui.AbsoluteSize
            local p = toAbs(Island.Position)
            local x = math.clamp(p.X, 8, math.max(8, vp.X - EXPANDED.X - 8))
            local y = math.clamp(p.Y, 8, math.max(8, vp.Y - EXPANDED.Y - 8))
            Expanded.Visible = true
            Tween(Compact, { GroupTransparency = 1 }, 0.15)
            Tween(Island, { Size = UDim2.fromOffset(EXPANDED.X, EXPANDED.Y), Position = UDim2.fromOffset(x, y) }, 0.5, Enum.EasingStyle.Back)
            task.delay(0.12, function() if expanded then Tween(Expanded, { GroupTransparency = 0 }, 0.25) end end)
        else
            Tween(Expanded, { GroupTransparency = 1 }, 0.15)
            Tween(Island, { Size = UDim2.fromOffset(COMPACT.X, COMPACT.Y) }, 0.4, Enum.EasingStyle.Quint)
            task.delay(0.15, function() if not expanded then Tween(Compact, { GroupTransparency = 0 }, 0.2) end end)
            task.delay(0.4, function() if not expanded then Expanded.Visible = false end end)
        end
    end

    local function showIsland()
        Island.Visible = true
        iScale.Scale = 0.45
        Tween(Island, { GroupTransparency = 0 }, 0.25)
        Tween(iScale, { Scale = 1 }, 0.6, Enum.EasingStyle.Back)
    end
    local function hideIsland()
        Tween(Island, { GroupTransparency = 1 }, 0.2)
        Tween(iScale, { Scale = 0.6 }, 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.27, function() if not minimized then Island.Visible = false end end)
    end

    local mScale = New("UIScale", { Scale = 1, Parent = Main })
    local savedPos
    local function islandCenter()
        return toAbs(Island.Position) + (expanded and EXPANDED or COMPACT) / 2
    end

    function Window:Minimize()
        if minimized or busy then return end
        minimized, busy = true, true
        savedPos = Main.Position
        local c = islandCenter()
        Tween(Main, { Position = UDim2.fromOffset(c.X, c.Y), GroupTransparency = 1 }, 0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        Tween(mScale, { Scale = 0.18 }, 0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.2, showIsland)
        task.delay(0.4, function()
            Main.Visible = false
            Main.Position = savedPos
            mScale.Scale = 1
            Main.GroupTransparency = 0
            busy = false
        end)
    end

    function Window:Restore()
        if not minimized or busy then return end
        minimized, busy = false, true
        local c = islandCenter()
        if expanded then setExpanded(false) end
        Main.Position = UDim2.fromOffset(c.X, c.Y)
        mScale.Scale = 0.18
        Main.GroupTransparency = 1
        Main.Visible = true
        hideIsland()
        Tween(Main, { Position = savedPos or UDim2.fromScale(0.5, 0.5), GroupTransparency = 0 }, 0.5, Enum.EasingStyle.Quint)
        Tween(mScale, { Scale = 1 }, 0.55, Enum.EasingStyle.Back)
        task.delay(0.56, function() busy = false end)
    end

    function Window:Toggle() if minimized then Window:Restore() else Window:Minimize() end end
    function Window:Destroy()
        for _, c in ipairs(Library._conns) do pcall(function() c:Disconnect() end) end
        Library._conns, Library._binds = {}, {}
        gui:Destroy()
    end

    -- input: tap = open, drag = move, press feedback, hover pop
    MakeDraggable(hit, Island)
    MakeDraggable(dragHeader, Island)
    local downPos
    Connect(hit.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            downPos = i.Position
            Tween(iScale, { Scale = 0.92 }, 0.08)
        end
    end)
    Connect(hit.InputEnded, function(i)
        if downPos and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            local tap = (i.Position - downPos).Magnitude < 6
            downPos = nil
            if tap then Window:Restore() else Tween(iScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back) end
        end
    end)
    Connect(hit.MouseEnter, function() if not expanded and not downPos then Tween(iScale, { Scale = 1.07 }, 0.15) end end)
    Connect(hit.MouseLeave, function() if not downPos then Tween(iScale, { Scale = 1 }, 0.2) end end)
    Connect(expandBtn.MouseButton1Click, function() setExpanded(true) end)
    Connect(collapseBtn.MouseButton1Click, function() setExpanded(false) end)
    Connect(openBtn.MouseButton1Click, function() Window:Restore() end)

    Connect(MinBtn.MouseButton1Click, function() Window:Minimize() end)
    Connect(CloseBtn.MouseButton1Click, function() Window:Destroy() end)

    local toggleKey = opts.ToggleKey or Enum.KeyCode.RightShift
    Connect(UserInputService.InputBegan, function(i, gp)
        if not gp and i.KeyCode == toggleKey then Window:Toggle() end
    end)

    Library.Windows[#Library.Windows + 1] = Window
    Library._active = Window
    return Window
end

function Library:Notify(o)
    if self._active then self._active:Notify(o) end
end

return Library
